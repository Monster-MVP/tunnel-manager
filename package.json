{
  "name": "tunnel-manager",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/web/src shared --max-warnings 0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.20.0",
    "typescript-eslint": "^8.24.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  }
}
